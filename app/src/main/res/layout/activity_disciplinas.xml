<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="@string/titulo_disciplinas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:background="#1E1E1E" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/itemProgramacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> Programação" android:textColor="#00E676" android:textSize="16sp" android:background="#1E1E1E" android:padding="16dp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/itemBancoDeDados" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> Banco de Dados" android:textColor="#00E676" android:textSize="16sp" android:background="#1E1E1E" android:padding="16dp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/itemEngenhariaSoftware" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> Engenharia de Software" android:textColor="#00E676" android:textSize="16sp" android:background="#1E1E1E" android:padding="16dp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/itemDesenvolvimentoWeb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> Desenvolvimento Web" android:textColor="#00E676" android:textSize="16sp" android:background="#1E1E1E" android:padding="16dp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/itemDesenvolvimentoMobile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> Desenvolvimento Mobile" android:textColor="#00E676" android:textSize="16sp" android:background="#1E1E1E" android:padding="16dp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/itemInteligenciaArtificial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> Inteligência Artificial" android:textColor="#00E676" android:textSize="16sp" android:background="#1E1E1E" android:padding="16dp" android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/btn_voltar"
        android:backgroundTint="#003311"
        android:textColor="#00E676" />

</LinearLayout>