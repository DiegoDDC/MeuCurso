<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtTituloDetalhes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Detalhes da Disciplina"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#B0BEC5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtNomeDisciplina"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nome da disciplina"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        app:layout_constraintTop_toBottomOf="@id/txtTituloDetalhes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCargaHoraria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Carga horária: 80 horas"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/txtNomeDisciplina"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtModalidade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Modalidade: Presencial"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/txtCargaHoraria"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtDescricaoDisciplina"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Descrição:\nNesta disciplina são estudados conceitos relacionados ao conteúdo do curso."
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        app:layout_constraintTop_toBottomOf="@id/txtModalidade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtProfessor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Professor: a definir"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/txtDescricaoDisciplina"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtPreRequisito"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pré-requisito: nenhum"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/txtProfessor"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnCompartilhar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Compartilhar"
        android:backgroundTint="#003311"
        android:textColor="#00E676"
        app:layout_constraintBottom_toTopOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_voltar"
        android:backgroundTint="#1E1E1E"
        android:textColor="#00E676"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>